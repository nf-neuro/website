---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { Analytics } from '@arraypress/analytics-astro';
---
<Default>
    <Analytics providers={[
        { type: 'goatcounter', endpoint: 'https://nf-neuro.goatcounter.com/count' },
        { type: 'custom', html: '<script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>' }
    ]} />
    <slot />
</Default>
